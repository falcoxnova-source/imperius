# =============================================================================
# XNOVA - FALCO-X UNIVERSO
# =============================================================================
# COMPLETE ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
#
# This file documents ALL environment variables used by the Xnova game.
# Copy this file to .env and configure the values for your environment.
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.docker.example .env
#   2. Fill in all REQUIRED variables
#   3. Optionally configure OPTIONAL variables
#   4. Run: docker compose up -d
#
# DEPLOYMENT MODES:
#   - Cloud Backend:     docker compose up -d
#   - Full Self-Hosted:  docker compose --profile self-hosted up -d
#
# =============================================================================



# =============================================================================
# SECTION 1: FRONTEND CONFIGURATION
# =============================================================================
# These variables are used by the React frontend application.
# They are embedded into the build at compile time.
# =============================================================================

# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL (REQUIRED)
# -----------------------------------------------------------------------------
# Description: The base URL of your Supabase project API
# Purpose:     Used by the frontend to connect to the Supabase backend
#              for authentication, database queries, and realtime updates
#
# Values:
#   - Cloud:       https://your-project-id.supabase.co
#   - Self-Hosted: http://localhost:8000 (or your server IP)
#
# Example: VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co

# -----------------------------------------------------------------------------
# VITE_SUPABASE_ANON_KEY (REQUIRED)
# -----------------------------------------------------------------------------
# Description: The anonymous/public API key for Supabase
# Purpose:     Allows the frontend to make authenticated requests to Supabase
#              This key is safe to expose in the frontend code
#              Row Level Security (RLS) policies protect your data
#
# How to get:
#   - Cloud: Supabase Dashboard > Settings > API > anon public
#   - Self-Hosted: Generate using JWT with 'anon' role
#
# Security Note:
#   - This key only has access to data permitted by RLS policies
#   - Never use service_role key in frontend code
#
# Example: VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# -----------------------------------------------------------------------------
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# SITE_URL (REQUIRED for production)
# -----------------------------------------------------------------------------
# Description: The public URL where your game is hosted
# Purpose:     Used for generating absolute URLs in emails, OAuth redirects,
#              and other external links
#
# Values:
#   - Development: http://localhost
#   - Production:  https://your-domain.com (must include protocol)
#
# Important: Must match the actual URL users use to access the game
# -----------------------------------------------------------------------------
SITE_URL=https://your-domain.com



# =============================================================================
# SECTION 2: BLOCKCHAIN CONFIGURATION (BSC)
# =============================================================================
# Configuration for the FXU token and BSC (Binance Smart Chain) integration.
# These values connect the game to the blockchain for deposits/withdrawals.
# =============================================================================

# -----------------------------------------------------------------------------
# VITE_TOKEN_CONTRACT (REQUIRED)
# -----------------------------------------------------------------------------
# Description: The BEP-20 smart contract address of the FXU token on BSC
# Purpose:     Used to interact with the FXU token for:
#              - Checking user balances
#              - Verifying deposits
#              - Processing withdrawals
#
# Network: BSC Mainnet (Chain ID: 56)
# Contract: 0xd19C01DE3C379441c3F4e8af442E10a3EE440CdE (Official FXU Token)
#
# IMPORTANT: Do not change this unless you're using a different token
# -----------------------------------------------------------------------------
VITE_TOKEN_CONTRACT=0xd19C01DE3C379441c3F4e8af442E10a3EE440CdE

# -----------------------------------------------------------------------------
# VITE_BSC_RPC_URL (REQUIRED)
# -----------------------------------------------------------------------------
# Description: The RPC endpoint URL for connecting to BSC network
# Purpose:     Used to read blockchain data (balances, transactions, etc.)
#
# Public RPC endpoints (free, may have rate limits):
#   - https://bsc-dataseed1.binance.org (primary)
#   - https://bsc-dataseed2.binance.org (backup)
#   - https://bsc-dataseed3.binance.org (backup)
#   - https://bsc-dataseed4.binance.org (backup)
#
# Paid providers (higher rate limits, more reliable):
#   - https://bsc-mainnet.infura.io/v3/YOUR_PROJECT_ID
#   - https://bsc-mainnet.nodereal.io/v1/YOUR_API_KEY
#
# Testnet (for development):
#   - https://data-seed-prebsc-1-s1.binance.org:8545
# -----------------------------------------------------------------------------
VITE_BSC_RPC_URL=https://bsc-dataseed1.binance.org

# -----------------------------------------------------------------------------
# VITE_BSC_CHAIN_ID (REQUIRED)
# -----------------------------------------------------------------------------
# Description: The chain ID of the BSC network
# Purpose:     Used for wallet connections and transaction signing
#
# Values:
#   - Mainnet: 56 (production)
#   - Testnet: 97 (development)
#
# IMPORTANT: Must match VITE_BSC_RPC_URL network
# -----------------------------------------------------------------------------
VITE_BSC_CHAIN_ID=56

# -----------------------------------------------------------------------------
# VITE_BSCSCAN_API_KEY (OPTIONAL but recommended)
# -----------------------------------------------------------------------------
# Description: API key for BscScan block explorer
# Purpose:     Used to verify transactions and get detailed tx info
#              Without this key, some features may have rate limits
#
# How to get:
#   1. Go to https://bscscan.com/register
#   2. Create an account and verify email
#   3. Go to API Keys section
#   4. Create a new API key
#
# Rate limits:
#   - Without key: 1 request/5 seconds
#   - With key: 5 requests/second (free tier)
# -----------------------------------------------------------------------------
VITE_BSCSCAN_API_KEY=your-bscscan-api-key



# =============================================================================
# SECTION 3: SELF-HOSTED SUPABASE CONFIGURATION
# =============================================================================
# These variables are ONLY required when running Supabase locally.
# Skip this section if using Supabase Cloud.
#
# To use: docker compose --profile self-hosted up -d
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: Master password for the PostgreSQL database
# Purpose:     Used by all Supabase services to connect to the database
#
# Requirements:
#   - Minimum 32 characters recommended
#   - Use strong, random password
#   - Never use in production if it's in version control
#
# Generate a secure password:
#   openssl rand -base64 32
#
# SECURITY WARNING: Change this from the default in production!
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=your-super-secret-database-password-min-32-chars

# -----------------------------------------------------------------------------
# POSTGRES_PORT (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: External port for PostgreSQL access
# Purpose:     Allows direct database connections (e.g., from pgAdmin)
# Default:     5432
#
# Change if you have another PostgreSQL instance running
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT_SECRET (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: Secret key used to sign and verify JWT tokens
# Purpose:     Secures all authentication tokens in the system
#              Used by Auth, REST, Realtime, and Storage services
#
# Requirements:
#   - Minimum 32 characters (256 bits)
#   - Use cryptographically random value
#   - NEVER expose or commit to version control
#
# Generate a secure secret:
#   openssl rand -base64 64
#
# SECURITY CRITICAL: Changing this invalidates ALL existing sessions!
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# -----------------------------------------------------------------------------
# JWT_EXPIRY (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: JWT token expiration time in seconds
# Purpose:     Controls how long users stay logged in
# Default:     3600 (1 hour)
#
# Common values:
#   - 3600    = 1 hour (default, most secure)
#   - 86400   = 24 hours
#   - 604800  = 7 days
#   - 2592000 = 30 days
#
# Security Note: Shorter = more secure, longer = better UX
# -----------------------------------------------------------------------------
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# SUPABASE_ANON_KEY (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: The anonymous API key for self-hosted Supabase
# Purpose:     Same as VITE_SUPABASE_ANON_KEY but for server-side services
#
# How to generate:
#   Use https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#   Or use the JWT generator at: https://jwt.io/
#
# JWT Payload:
#   {
#     "role": "anon",
#     "iss": "supabase",
#     "iat": 1234567890,
#     "exp": 9999999999
#   }
#
# Sign with: JWT_SECRET using HS256 algorithm
# -----------------------------------------------------------------------------
SUPABASE_ANON_KEY=your-generated-anon-key

# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: The service role API key with elevated privileges
# Purpose:     Used by Edge Functions and admin operations
#              Bypasses Row Level Security (RLS) policies
#
# SECURITY WARNING:
#   - NEVER expose this key in frontend code
#   - Only use server-side in Edge Functions
#   - Has full database access!
#
# JWT Payload:
#   {
#     "role": "service_role",
#     "iss": "supabase",
#     "iat": 1234567890,
#     "exp": 9999999999
#   }
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-generated-service-role-key

# -----------------------------------------------------------------------------
# API_EXTERNAL_URL (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: The external URL where Kong API gateway is accessible
# Purpose:     Used for OAuth redirects and generating external API URLs
# Default:     http://localhost:8000
#
# For production: https://api.your-domain.com
# -----------------------------------------------------------------------------
API_EXTERNAL_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# KONG_HTTP_PORT / KONG_HTTPS_PORT (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Ports for the Kong API gateway
# Purpose:     Change if defaults conflict with other services
# Defaults:    HTTP=8000, HTTPS=8443
# -----------------------------------------------------------------------------
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443



# =============================================================================
# SECTION 4: EMAIL CONFIGURATION (SMTP)
# =============================================================================
# Configure email sending for password reset, verification, and notifications.
# Required for production deployments.
# =============================================================================

# -----------------------------------------------------------------------------
# SMTP_HOST (REQUIRED for email features)
# -----------------------------------------------------------------------------
# Description: Hostname of your SMTP server
# Purpose:     Sends emails for password reset, verification, etc.
#
# Common providers:
#   - Gmail:      smtp.gmail.com (requires app password)
#   - Outlook:    smtp.office365.com
#   - SendGrid:   smtp.sendgrid.net
#   - Mailgun:    smtp.mailgun.org
#   - Amazon SES: email-smtp.{region}.amazonaws.com
#
# Leave empty to disable email features
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com

# -----------------------------------------------------------------------------
# SMTP_PORT (REQUIRED for email features)
# -----------------------------------------------------------------------------
# Description: Port number for SMTP connection
# Purpose:     Specifies which port to use for email sending
#
# Common ports:
#   - 25:   Standard SMTP (often blocked by ISPs)
#   - 465:  SMTP over SSL (deprecated but still used)
#   - 587:  SMTP with STARTTLS (recommended)
#   - 2525: Alternative port (some providers)
# -----------------------------------------------------------------------------
SMTP_PORT=587

# -----------------------------------------------------------------------------
# SMTP_USER (REQUIRED for email features)
# -----------------------------------------------------------------------------
# Description: Username for SMTP authentication
# Purpose:     Authenticates with the email server
#
# Usually your email address or API key depending on provider
# Example: noreply@your-domain.com
# -----------------------------------------------------------------------------
SMTP_USER=your-smtp-username

# -----------------------------------------------------------------------------
# SMTP_PASS (REQUIRED for email features)
# -----------------------------------------------------------------------------
# Description: Password for SMTP authentication
# Purpose:     Authenticates with the email server
#
# For Gmail: Use App Password (not regular password)
#   https://support.google.com/accounts/answer/185833
#
# For API-based services: Use API key
#
# SECURITY: Never commit real passwords to version control
# -----------------------------------------------------------------------------
SMTP_PASS=your-smtp-password

# -----------------------------------------------------------------------------
# SMTP_ADMIN_EMAIL (REQUIRED for email features)
# -----------------------------------------------------------------------------
# Description: Admin email address for system notifications
# Purpose:     Receives system alerts and admin notifications
#              Used as reply-to address for automated emails
# -----------------------------------------------------------------------------
SMTP_ADMIN_EMAIL=admin@your-domain.com

# -----------------------------------------------------------------------------
# SMTP_SENDER_NAME (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Display name shown in email From field
# Purpose:     Makes emails more recognizable to users
# Default:     Xnova Game
#
# Example: "Xnova Game" <noreply@your-domain.com>
# -----------------------------------------------------------------------------
SMTP_SENDER_NAME=Xnova Game

# -----------------------------------------------------------------------------
# ENABLE_EMAIL_AUTOCONFIRM (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Automatically confirm email addresses without verification
# Purpose:     Skip email verification step during registration
# Default:     true
#
# Values:
#   - true:  Users can login immediately (development)
#   - false: Users must verify email before login (production)
#
# IMPORTANT: Set to false in production for security
# -----------------------------------------------------------------------------
ENABLE_EMAIL_AUTOCONFIRM=true

# -----------------------------------------------------------------------------
# RATE_LIMIT_EMAIL (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Maximum emails per hour to prevent abuse
# Purpose:     Protects against email bombing attacks
# Default:     100
#
# Recommended: 10-50 for production
# -----------------------------------------------------------------------------
RATE_LIMIT_EMAIL=100



# =============================================================================
# SECTION 5: REALTIME CONFIGURATION
# =============================================================================
# Configuration for Supabase Realtime WebSocket server.
# Enables real-time updates for fleet movements, attacks, etc.
# =============================================================================

# -----------------------------------------------------------------------------
# REALTIME_ENC_KEY (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: Encryption key for Realtime database connections
# Purpose:     Encrypts sensitive data in Realtime service
#
# Requirements: Exactly 32 characters (256 bits)
#
# Generate:
#   openssl rand -hex 16
# -----------------------------------------------------------------------------
REALTIME_ENC_KEY=supabaserealtime_enc_key_32chars

# -----------------------------------------------------------------------------
# REALTIME_SECRET_KEY_BASE (REQUIRED for self-hosted)
# -----------------------------------------------------------------------------
# Description: Secret key for Phoenix framework sessions
# Purpose:     Used by Elixir/Phoenix for session encryption
#
# Requirements: Minimum 64 characters
#
# Generate:
#   openssl rand -base64 48
# -----------------------------------------------------------------------------
REALTIME_SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq



# =============================================================================
# SECTION 6: STORAGE CONFIGURATION
# =============================================================================
# Configuration for file storage (avatars, images, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# STORAGE_FILE_SIZE_LIMIT (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Maximum file upload size in bytes
# Purpose:     Limits file uploads to prevent storage abuse
# Default:     52428800 (50MB)
#
# Common values:
#   - 5242880:   5MB  (avatars only)
#   - 10485760:  10MB (small files)
#   - 52428800:  50MB (default)
#   - 104857600: 100MB (large files)
# -----------------------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800



# =============================================================================
# SECTION 7: OPTIONAL SETTINGS
# =============================================================================
# Additional configuration options for fine-tuning your deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# DISABLE_SIGNUP (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Disable new user registration
# Purpose:     Close registration for private/invite-only servers
# Default:     false
#
# Values:
#   - false: Anyone can register
#   - true:  Registration disabled
# -----------------------------------------------------------------------------
DISABLE_SIGNUP=false

# -----------------------------------------------------------------------------
# ADDITIONAL_REDIRECT_URLS (OPTIONAL)
# -----------------------------------------------------------------------------
# Description: Additional URLs allowed for OAuth/Auth redirects
# Purpose:     Allow authentication from multiple domains
#
# Format: Comma-separated list of URLs
# Example: https://dev.xnova.com,https://staging.xnova.com
# -----------------------------------------------------------------------------
ADDITIONAL_REDIRECT_URLS=



# =============================================================================
# SECTION 8: EXTERNAL SERVICES (SECRETS)
# =============================================================================
# These secrets should be configured in Supabase Edge Function Secrets,
# NOT in this .env file for security reasons.
#
# Configure in: Supabase Dashboard > Edge Functions > Secrets
# =============================================================================

# -----------------------------------------------------------------------------
# WALLET_PRIVATE_KEY (Edge Function Secret)
# -----------------------------------------------------------------------------
# Description: Private key for the deposit/withdrawal wallet
# Purpose:     Signs blockchain transactions for withdrawals
#
# SECURITY CRITICAL:
#   - NEVER put this in .env file
#   - NEVER commit to version control
#   - ONLY configure in Supabase Edge Function Secrets
#
# The deposit wallet ADDRESS is configured in the admin panel.
# -----------------------------------------------------------------------------
# WALLET_PRIVATE_KEY=<configure in Supabase secrets>

# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN (Edge Function Secret)
# -----------------------------------------------------------------------------
# Description: Token for the Telegram bot
# Purpose:     Sends notifications and verifies Telegram memberships
#
# How to get:
#   1. Message @BotFather on Telegram
#   2. Create new bot with /newbot
#   3. Copy the token provided
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=<configure in Supabase secrets>

# -----------------------------------------------------------------------------
# OPENAI_API_KEY (Edge Function Secret)
# -----------------------------------------------------------------------------
# Description: API key for OpenAI (AI Assistant feature)
# Purpose:     Powers the in-game AI assistant
#
# How to get: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=<configure in Supabase secrets>

# -----------------------------------------------------------------------------
# RESEND_API_KEY (Edge Function Secret)
# -----------------------------------------------------------------------------
# Description: API key for Resend email service
# Purpose:     Alternative email sending for Edge Functions
#
# How to get: https://resend.com/api-keys
# -----------------------------------------------------------------------------
# RESEND_API_KEY=<configure in Supabase secrets>
