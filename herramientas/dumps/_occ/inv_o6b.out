691:       IF v_debris_metal > 0 OR v_debris_crystal > 0 THEN
692:         INSERT INTO debris_fields (galaxy, solar_system, position, metal, crystal) VALUES (fleet_record.target_galaxy, fleet_record.target_system, fleet_record.target_position, v_debris_metal, v_debris_crystal) ON CONFLICT (galaxy, solar_system, position) DO UPDATE SET metal = debris_fields.metal + EXCLUDED.metal, crystal = debris_fields.crystal + EXCLUDED.crystal, updated_at = NOW();
693:         UPDATE profiles SET debris_metal_total = debris_metal_total + v_debris_metal, debris_crystal_total = debris_crystal_total + v_debris_crystal WHERE id = fleet_record.user_id;
694:       END IF;
695:       -- Formacion de luna a partir del campo de escombros (ya existia en la BD, ahora si se invoca)
696:       BEGIN
697:         v_moon_result := check_moon_creation(fleet_record.target_galaxy, fleet_record.target_system, fleet_record.target_position, COALESCE(v_debris_metal, 0), COALESCE(v_debris_crystal, 0));
698:       EXCEPTION WHEN OTHERS THEN
699:         v_moon_result := NULL;
700:       END;
701:       -- Log battle report so the destruction ranking (get_destruction_ranking) can compute points
702:       INSERT INTO battle_reports (attacker_id, defender_id, planet_id, coordinates, result, rounds, debris_metal, debris_crystal, loot_metal, loot_crystal, loot_deuterium, report_data, battle_type, galaxy, solar_system, position, created_at)
703:       VALUES (fleet_record.user_id, target_planet.user_id, target_planet.id, fleet_record.target_galaxy || ':' || fleet_record.target_system || ':' || fleet_record.target_position, combat_result->>'result', COALESCE((combat_result->>'rounds')::integer, 0), v_debris_metal, v_debris_crystal, COALESCE(loot_metal, 0), COALESCE(loot_crystal, 0), COALESCE(loot_deuterium, 0), combat_result, 'attack', fle
704:       v_atk_name := COALESCE((SELECT pr.username FROM profiles pr WHERE pr.id = fleet_record.user_id), 'Desconocido');
705:       v_def_name := COALESCE((SELECT pr.username FROM profiles pr WHERE pr.id = target_planet.user_id), 'Desconocido');
706:       v_atk_origin := COALESCE((SELECT op.galaxy || ':' || op.solar_system || ':' || op.position FROM planets op WHERE op.id = fleet_record.origin_planet_id), '?:?:?');
707:       v_battle_report := jsonb_build_object(
708:         'version', 2,
709:         'battle_type', 'attack',
710:         'attacker', v_atk_name,
711:         'defender', v_def_name,
712:         'planet_name', target_planet.name,
713:         'target_type', COALESCE(fleet_record.target_type, 'planet'),
714:         'attacker_origin', v_atk_origin,
715:         'coordinates', fleet_record.target_galaxy || ':' || fleet_record.target_system || ':' || fleet_record.target_position,
716:         'result', combat_result->>'result',
717:         'rounds', COALESCE((combat_result->>'rounds')::integer, 0),
718:         'rounds_data', COALESCE(combat_result->'rounds_data', '[]'::jsonb),
719:         'attacker_ships', battle_units_diff(combat_result->'initial_attacker', combat_result->'attacker_remaining', 'ships'),
720:         'defender_ships', battle_units_diff(combat_result->'initial_defender', combat_result->'defender_remaining', 'ships'),
721:         'defender_defenses', battle_units_diff(combat_result->'initial_defender', combat_result->'defender_remaining', 'defenses'),
722:         'attacker_losses', jsonb_build_object('metal', FLOOR(COALESCE((combat_result->>'attacker_losses_metal')::numeric, 0)), 'crystal', FLOOR(COALESCE((combat_result->>'attacker_losses_crystal')::numeric, 0))),
723:         'defender_losses', jsonb_build_object('metal', FLOOR(COALESCE((combat_result->>'defender_losses_metal')::numeric, 0)), 'crystal', FLOOR(COALESCE((combat_result->>'defender_losses_crystal')::numeric, 0))),
724:         'debris', jsonb_build_object('metal', FLOOR(COALESCE(v_debris_metal, 0)), 'crystal', FLOOR(COALESCE(v_debris_crystal, 0))),
725:         'loot', jsonb_build_object('metal', FLOOR(COALESCE(loot_metal, 0)), 'crystal', FLOOR(COALESCE(loot_crystal, 0)), 'deuterium', FLOOR(COALESCE(loot_deuterium, 0))),
726:         'moon', COALESCE(v_moon_result, jsonb_build_object('moon_created', false, 'moon_chance', 0)),
727:         'building_damage', v_building_damage
728:       );
729:       INSERT INTO messages (sender_id, recipient_id, subject, body, message_type) VALUES (NULL, fleet_record.user_id, format('Reporte de Combate - %s', CASE (combat_result->>'result') WHEN 'attacker_won' THEN 'Victoria' WHEN 'defender_won' THEN 'Derrota' ELSE 'Empate' END), (v_battle_report || jsonb_build_object('perspective', 'attacker'))::text, 'battle');
730:       INSERT INTO messages (sender_id, recipient_id, subject, body, message_type) VALUES (NULL, target_planet.user_id, format('Tu planeta %s fue atacado - %s', target_planet.name, CASE (combat_result->>'result') WHEN 'attacker_won' THEN 'Derrota' WHEN 'defender_won' THEN 'Victoria' ELSE 'Empate' END), (v_battle_report || jsonb_build_object('perspective', 'defender'))::text, 'battle');
731:       -- [DEPOSITO ALIANZA] Copia del reporte para los aliados cuyas flotas
732:       -- estacionadas participaron en la defensa del planeta.
733:       INSERT INTO messages (sender_id, recipient_id, subject, body, message_type)
734:       SELECT NULL,
735:              f.user_id,
736:              format('Tu flota defendio %s - %s', target_planet.name,
737:                CASE (combat_result->>'result')
738:                  WHEN 'attacker_won' THEN 'Derrota'
739:                  WHEN 'defender_won' THEN 'Victoria'
740:                  ELSE 'Empate' END),
741:              (v_battle_report || jsonb_build_object('perspective', 'defender'))::text,
742:              'battle'
743:       FROM fleets f
744:       WHERE f.id IN (
745:               SELECT DISTINCT (u->>'source')::uuid
746:               FROM jsonb_array_elements(combat_result->'defender_remaining') u
747:               WHERE (u->>'source') NOT IN ('planet', 'defense')
748:             )
749:         AND f.user_id <> target_planet.user_id
750:         AND f.user_id <> fleet_record.user_id
751:       GROUP BY f.user_id;
752:       IF (combat_result->>'result') = 'attacker_won' AND public._occ_try_start(p_fleet_id, target_planet.id, loot_metal, loot_crystal, loot_deuterium) THEN RETURN; END IF; /* [OCUPA1-pfa2] */
753:       IF EXISTS (SELECT 1 FROM fleet_ships WHERE fleet_id = p_fleet_id AND quantity > 0) THEN
754:         UPDATE fleets SET is_returning = true WHERE id = p_fleet_id;
755:       ELSE
756:         UPDATE fleets SET is_completed = true WHERE id = p_fleet_id;
757:       END IF;
758:     ELSE
759:       UPDATE fleets SET is_returning = true WHERE id = p_fleet_id;
760:     END IF;
